<?xml version="1.0" encoding="utf-8"?>
<!-- Inner layout for DecoratedBarcodeView (ids are required by the zxing library). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/zxing_barcode_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.journeyapps.barcodescanner.ViewfinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_viewfinder_mask="#99000000"
        app:zxing_viewfinder_laser="@android:color/transparent"
        app:zxing_viewfinder_laser_visibility="false"
        app:zxing_result_view="@android:color/transparent"
        app:zxing_possible_result_points="@android:color/transparent" />

    <!-- Kept for the library (status text); the hint is drawn by ScanFrameView instead. -->
    <TextView
        android:id="@+id/zxing_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</merge>
